{
  "name": "@bearstudio/ui-state",
  "version": "1.1.0",
  "description": "A lightweight utility library to easily manage UI display states such as loading, error or any custom-defined state",
  "keywords": [
    "pattern",
    "state",
    "ts",
    "typescript",
    "ui"
  ],
  "bugs": {
    "url": "https://github.com/BearStudio/ui-state/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BearStudio/ui-state.git",
    "directory": "packages/ui-state"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "build": "tsup src/index.ts --format esm,cjs --minify && tsc -p tsconfig.build.json",
    "lint": "oxlint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@bearstudio/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/ui": "4.1.11",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
