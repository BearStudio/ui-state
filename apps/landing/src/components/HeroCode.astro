  <span class="text-code-kw">if</span> (bookQuery.status === <span class="text-code-str">"error"</span>) <span class="text-code-kw">return</span> set(<span class="text-code-str">"error"</span>);
  <span class="text-code-kw">if</span> (!bookQuery.data) <span class="text-code-kw">return</span> set(<span class="text-code-str">"empty"</span>);
