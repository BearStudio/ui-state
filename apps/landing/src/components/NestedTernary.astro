---
// Conditional chains still typecheck when a later status is missing.
---

<pre
  class="min-h-60 w-full min-w-0 flex-1 overflow-x-auto overflow-y-hidden bg-paper p-4 font-mono text-[13px] leading-6 text-ink-soft sm:text-sm lg:h-full"
><code><span class="italic text-comment">// Convenient to factor, but this bypasses inference and type safety.</span>
<span class="text-ink">const</span> bears = query.data ?? [];
<span class="text-ink">const</span> search = filters.search;

<span class="italic text-comment">// State logic mixed with each render = a mess.</span>
<span class="text-ink">return</span> (
  <span class="text-jsx">&lt;&gt;</span>
    &#123;query.isPending && <span class="text-jsx">&lt;Spinner /&gt;</span>&#125;
    &#123;!query.isPending &&
      query.isError &&
      query.error.code === "FORBIDDEN" && <span class="text-jsx">&lt;Forbidden /&gt;</span>&#125;
    &#123;!query.isPending &&
      query.isError &&
      query.error.code !== "FORBIDDEN" && <span class="text-jsx">&lt;Error /&gt;</span>&#125;
    &#123;!query.isPending && !query.isError && !bears.length && search && (
      <span class="text-jsx">&lt;NoResults search=&#123;search&#125; /&gt;</span>
    )&#125;
    &#123;!query.isPending && !query.isError && !bears.length && !search && (
      <span class="text-jsx">&lt;Empty /&gt;</span>
    )&#125;
    &#123;!query.isPending && !query.isError && !!bears.length && (
      <span class="text-jsx">&lt;List bears=&#123;bears&#125; /&gt;</span>
    )&#125;
  <span class="text-jsx">&lt;/&gt;</span>
);</code></pre>
