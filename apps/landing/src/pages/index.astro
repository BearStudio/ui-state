---
import Layout from "../layouts/Layout.astro";
import HeroCode from "../components/HeroCode.astro";
import NestedTernary from "../components/NestedTernary.astro";
import { StateDemo } from "../components/StateDemo.tsx";

const title = "@bearstudio/ui-state — exhaustive UI states for React";
const description =
  "A small TypeScript helper that maps pending, error, and custom statuses onto match + exhaustive(). Miss a status, tsc fails.";
const github = "https://github.com/BearStudio/ui-state";
const install = "pnpm add @bearstudio/ui-state";
---

<Layout title={title} description={description}>
  <header class="border-b border-line">
    <div
      class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4"
    >
      <a href="/" class="font-mono text-sm font-medium"
        >@bearstudio/ui-state</a
      >
      <nav aria-label="Primary">
        <ul class="flex items-center gap-5 text-sm">
          <li>
            <a href="#demo" class="text-ink-soft hover:text-ink">Demo</a>
          </li>
          <li>
            <a href="#install" class="text-ink-soft hover:text-ink">Install</a>
          </li>
          <li>
            <a href={github} class="text-ink-soft hover:text-ink">GitHub</a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
      <p class="font-mono text-xs tracking-wide text-accent uppercase">
        React · TypeScript · MIT
      </p>
      <h1
        class="mt-4 max-w-3xl text-4xl font-medium tracking-tight text-balance sm:text-5xl"
      >
        UI states you can exhaust.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-ink-soft text-pretty">
        <code class="font-mono text-[0.95em] text-ink">getUiState</code> maps
        pending, error, and the statuses you actually have onto one
        <code class="font-mono text-[0.95em] text-ink">match</code> chain.
        <code class="font-mono text-[0.95em] text-ink">exhaustive()</code> is
        a type error until every status has a branch. For React screens that
        already know if a query is loading — not a new store.
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a
          href={github}
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-5 text-sm font-medium text-accent-ink"
        >
          GitHub
        </a>
        <p
          class="rounded-md border border-line bg-paper-2 px-4 py-2.5 font-mono text-sm"
        >
          {install}
        </p>
      </div>
      <p class="mt-4 text-sm text-ink-soft">
        MIT. <code class="font-mono">exhaustive()</code> fails the type check
        if a status is unmatched.
      </p>
      <div class="mt-12">
        <HeroCode />
      </div>
    </section>

    <section class="border-t border-line bg-paper-2">
      <div class="mx-auto grid max-w-5xl gap-10 px-4 py-16 lg:grid-cols-2">
        <div>
          <h2 class="text-2xl font-medium">Nested ternaries do not scale.</h2>
          <p class="mt-3 text-ink-soft">
            Loading, error, data. Then empty. Then not-found. Each new status
            is another branch to paste into every screen. Miss one and the UI
            still typechecks.
          </p>
        </div>
        <NestedTernary />
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-16">
      <h2 class="text-2xl font-medium">Declare the state once. Match it.</h2>
      <p class="mt-3 max-w-2xl text-ink-soft">
        Same API as the README. <code class="font-mono text-ink">match</code>
        + <code class="font-mono text-ink">exhaustive()</code> — not a runtime
        type guard.
      </p>
      <div class="mt-8">
        <HeroCode />
      </div>
    </section>

    <section id="demo" class="border-t border-line bg-paper-2">
      <div class="mx-auto max-w-5xl px-4 py-16">
        <h2 class="text-2xl font-medium">The package, running.</h2>
        <p class="mt-3 max-w-2xl text-ink-soft">
          This island hydrates on view and calls
          <code class="font-mono text-ink">getUiState</code> from
          <code class="font-mono text-ink">@bearstudio/ui-state</code>. Flip
          pending, error, and default. Each view is a
          <code class="font-mono text-ink">match</code> branch; the chain ends
          with <code class="font-mono text-ink">exhaustive()</code>.
        </p>
        <div class="mt-8">
          <StateDemo client:visible />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-16">
      <h2 class="text-2xl font-medium">What you get</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        <li class="rounded-xl border border-line bg-paper-2 p-5">
          <h3 class="font-medium">Exhaustive matching</h3>
          <p class="mt-2 text-sm text-ink-soft">
            <code class="font-mono text-ink">exhaustive()</code> does not type
            check until every inferred status has a
            <code class="font-mono text-ink">match</code>. A new status is a
            compile error, not a blank screen.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-paper-2 p-5">
          <h3 class="font-medium">Your statuses, not a fixed enum</h3>
          <p class="mt-2 text-sm text-ink-soft">
            pending, error, default, empty, not-found, or
            <code class="font-mono text-ink">show-input</code>. The helper
            infers the union from <code class="font-mono text-ink">set()</code>.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-paper-2 p-5">
          <h3 class="font-medium">Payload per status</h3>
          <p class="mt-2 text-sm text-ink-soft">
            <code class="font-mono text-ink">set("default", &#123; book &#125;)</code>
            carries data on that branch. pending does not need a fake book.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-paper-2 p-5">
          <h3 class="font-medium">when() for a single branch</h3>
          <p class="mt-2 text-sm text-ink-soft">
            <code class="font-mono text-ink">ui.when("pending", …)</code>
            renders that status and returns null otherwise. Use
            <code class="font-mono text-ink">match</code> when you want the
            full set.
          </p>
        </li>
        <li class="rounded-xl border border-line bg-paper-2 p-5">
          <h3 class="font-medium">Small, React as a peer</h3>
          <p class="mt-2 text-sm text-ink-soft">
            One function. No store, no context, no extra runtime. Wire it to
            TanStack Query, fetch, or flags you already have.
          </p>
        </li>
      </ul>
    </section>

    <section id="install" class="border-t border-line bg-ink text-paper">
      <div class="mx-auto max-w-5xl px-4 py-16">
        <h2 class="text-2xl font-medium">Install</h2>
        <p
          class="mt-6 inline-block rounded-md bg-code px-4 py-3 font-mono text-sm"
        >
          {install}
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href={github}
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-5 text-sm font-medium text-accent-ink"
          >
            GitHub
          </a>
          <p class="font-mono text-sm text-code-muted">{install}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/10 bg-ink text-code-muted">
    <div
      class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-sm"
    >
      <p>MIT · BearStudio</p>
      <p>
        <a href={github} class="hover:text-paper">GitHub</a>
        <span aria-hidden="true"> · </span>
        <a href="https://www.bearstudio.fr" class="hover:text-paper"
          >bearstudio.fr</a
        >
      </p>
    </div>
  </footer>
</Layout>
