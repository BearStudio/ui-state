---
import Layout from "../layouts/Layout.astro";
import HeroCode from "../components/HeroCode.astro";
import NestedTernary from "../components/NestedTernary.astro";
import { StateDemo } from "../components/StateDemo.tsx";

const title = "@bearstudio/ui-state — exhaustive UI states for React";
const description =
  "A small TypeScript helper that maps pending, error, and custom statuses onto match + exhaustive(). Miss a status, tsc fails.";
const github = "https://github.com/BearStudio/ui-state";
const install = "pnpm add @bearstudio/ui-state";
---

<Layout title={title} description={description}>
  <header class="border-b border-line">
    <div
      class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
    >
      <a
        href="/"
        class="inline-flex min-h-11 items-center font-mono text-sm font-medium"
      >
        @bearstudio/ui-state
      </a>
      <nav aria-label="Primary">
        <ul class="flex items-center gap-1 text-sm">
          <li>
            <a
              href="#demo"
              class="inline-flex min-h-11 items-center px-2 text-ink-soft hover:text-ink"
            >
              Demo
            </a>
          </li>
          <li>
            <a
              href="#install"
              class="inline-flex min-h-11 items-center px-2 text-ink-soft hover:text-ink"
            >
              Install
            </a>
          </li>
          <li>
            <a
              href={github}
              class="inline-flex min-h-11 items-center px-2 text-ink-soft hover:text-ink"
            >
              GitHub
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:pt-24 sm:pb-16">
      <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <h1
            class="text-4xl font-medium tracking-tight text-balance sm:text-5xl"
          >
            UI states you can exhaust.
          </h1>
          <p class="mt-5 max-w-[46ch] text-lg text-ink-soft text-pretty">
            <code class="font-mono text-[0.95em] text-ink">getUiState</code> maps
            pending, error, and the statuses you actually have onto one
            <code class="font-mono text-[0.95em] text-ink">match</code> chain.
            <code class="font-mono text-[0.95em] text-ink">exhaustive()</code> is
            a type error until every status has a branch. For React screens that
            already know if a query is loading — not a new store.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <p
              class="inline-flex min-h-11 max-w-full items-center overflow-x-auto rounded-lg bg-ink px-5 font-mono text-sm text-paper"
            >
              {install}
            </p>
            <a
              href={github}
              class="inline-flex min-h-11 items-center text-sm text-ink-soft hover:text-ink"
            >
              Source on GitHub
            </a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <HeroCode />
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper-2">
      <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
        <div class="max-w-xl">
          <h2 class="text-2xl font-medium">Nested ternaries do not scale.</h2>
          <p class="mt-3 text-ink-soft">
            Loading, error, data. Then empty. Then not-found. Each new status
            is another branch to paste into every screen. Miss one and the UI
            still typechecks.
          </p>
        </div>
        <div class="mt-8">
          <NestedTernary />
        </div>
      </div>
    </section>

    <section id="demo" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
        <h2 class="text-2xl font-medium">The package, running.</h2>
        <p class="mt-3 max-w-xl text-ink-soft">
          This island hydrates on view and calls
          <code class="font-mono text-ink">getUiState</code> from
          <code class="font-mono text-ink">@bearstudio/ui-state</code>. Flip pending, error,
          and default. Each view is a
          <code class="font-mono text-ink">match</code> branch; the chain ends
          with <code class="font-mono text-ink">exhaustive()</code> — a type check, not a runtime type guard.
        </p>
        <div class="mt-8 max-w-xl">
          <StateDemo client:visible />
        </div>
      </div>
    </section>

    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
        <h2 class="text-2xl font-medium">What you get</h2>
        <dl class="mt-8 max-w-xl">
          <div class="border-t border-line py-5">
            <dt class="font-mono text-sm">exhaustive()</dt>
            <dd class="mt-1 text-ink-soft">
              A type error until every status from
              <code class="font-mono text-ink">set()</code> has a
              <code class="font-mono text-ink">match</code>. A new status is a
              compile error, not a blank screen.
            </dd>
          </div>
          <div class="border-t border-line py-5">
            <dt class="font-mono text-sm">set()</dt>
            <dd class="mt-1 text-ink-soft">
              Infers the union — pending, empty, not-found, or
              <code class="font-mono text-ink">show-input</code>. Payload is
              optional and typed on that branch.
            </dd>
          </div>
          <div class="border-t border-line py-5">
            <dt class="font-mono text-sm">when()</dt>
            <dd class="mt-1 text-ink-soft">
              <code class="font-mono text-ink">ui.when("pending", …)</code>
              renders that status and returns null otherwise. Use
              <code class="font-mono text-ink">match</code> when you want the
              full set.
            </dd>
          </div>
          <div class="border-t border-line border-b py-5">
            <dt class="font-medium">React as a peer</dt>
            <dd class="mt-1 text-ink-soft">
              One function. No store, no context, no extra runtime. Wire it to
              TanStack Query, fetch, or flags you already have.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="install" class="border-t border-line bg-paper-2">
      <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
        <h2 class="text-2xl font-medium">Install</h2>
        <p class="mt-3 max-w-xl text-ink-soft">
          Peer React. No store. Wire it to the query status you already have.
        </p>
        <p
          class="mt-8 inline-flex min-h-11 max-w-full items-center overflow-x-auto rounded-lg bg-ink px-5 font-mono text-sm text-paper"
        >
          {install}
        </p>
        <p class="mt-4">
          <a
            href={github}
            class="inline-flex min-h-11 items-center text-sm text-ink-soft hover:text-ink"
          >
            Source on GitHub
          </a>
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-sm text-ink-soft"
    >
      <p>MIT · BearStudio</p>
      <p>
        <a href={github} class="hover:text-ink">GitHub</a>
        <span aria-hidden="true"> · </span>
        <a href="https://www.bearstudio.fr" class="hover:text-ink">bearstudio.fr</a>
      </p>
    </div>
  </footer>
</Layout>
