---
import Layout from "../layouts/Layout.astro";
import HeroCode from "../components/HeroCode.astro";
import NestedTernary from "../components/NestedTernary.astro";
import { StateDemo } from "../components/StateDemo.tsx";

const title = "@bearstudio/ui-state — exhaustive UI states for React";
const description =
  "A small TypeScript helper that maps pending, error, and custom statuses onto match + exhaustive(). Miss a status, tsc fails.";
const github = "https://github.com/BearStudio/ui-state";
const install = "pnpm add @bearstudio/ui-state";
---

<Layout title={title} description={description}>
  <header class="border-b border-line">
    <div
      class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
    >
      <a
        href="/"
        class="inline-flex min-h-11 items-center font-mono text-sm font-medium"
      >
        @bearstudio/ui-state
      </a>
      <nav aria-label="Primary">
        <ul class="flex items-center gap-1 text-sm">
          <li>
            <a
              href="#demo"
              class="inline-flex min-h-11 items-center px-2 text-ink-soft hover:text-ink"
            >
              Demo
            </a>
          </li>
          <li>
            <a
              href="#install"
              class="inline-flex min-h-11 items-center px-2 text-ink-soft hover:text-ink"
            >
              Install
            </a>
          </li>
          <li>
            <a
              href={github}
              class="inline-flex min-h-11 items-center px-2 text-ink-soft hover:text-ink"
            >
              GitHub
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
      <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <h1
            class="text-4xl font-medium tracking-tight text-balance sm:text-5xl"
          >
            UI states you can exhaust.
          </h1>
          <p class="mt-5 max-w-[46ch] text-lg text-ink-soft text-pretty">
            <code class="font-mono text-[0.95em] text-ink">getUiState</code> maps
            pending, error, and the statuses you actually have onto one
            <code class="font-mono text-[0.95em] text-ink">match</code> chain.
            <code class="font-mono text-[0.95em] text-ink">exhaustive()</code> is
            a type error until every status has a branch. For React screens that
            already know if a query is loading — not a new store.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
            <pre
              class="m-0 overflow-x-auto rounded-lg border border-line bg-paper-2 px-4 py-2.5 font-mono text-sm"
            ><code>{install}</code></pre>
            <a href={github} class="text-sm text-ink-soft hover:text-ink">
              GitHub
            </a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <HeroCode />
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper-2">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 lg:grid-cols-2 lg:items-start">
        <div>
          <h2 class="text-2xl font-medium">
            Miss a status, tsc fails.
          </h2>
          <p class="mt-3 text-ink-soft">
            Loading, error, data. Then empty. Then not-found. Each new status is
            another branch to paste into every screen. Miss one and a ternary
            still typechecks. <code class="font-mono text-ink">exhaustive()</code>
            does not.
          </p>
        </div>
        <NestedTernary />
      </div>
    </section>

    <section id="demo" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20">
        <h2 class="text-2xl font-medium">The package, running.</h2>
        <p class="mt-3 max-w-xl text-ink-soft">
          This island hydrates on view and calls
          <code class="font-mono text-ink">getUiState</code> from
          <code class="font-mono text-ink">@bearstudio/ui-state</code>. Flip
          pending, error, and default. Each view is a
          <code class="font-mono text-ink">match</code> branch; the chain ends
          with <code class="font-mono text-ink">exhaustive()</code>.
        </p>
        <div class="mt-8 max-w-2xl">
          <StateDemo client:visible />
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper-2">
      <div class="mx-auto max-w-6xl px-4 py-20">
        <h2 class="text-2xl font-medium">What you get</h2>
        <dl class="mt-10 max-w-xl space-y-8">
          <div>
            <dt class="font-medium">
              <code class="font-mono">exhaustive()</code>
            </dt>
            <dd class="mt-2 text-ink-soft">
              Does not type-check until every inferred status has a
              <code class="font-mono text-ink">match</code>. A new status is a
              compile error, not a blank screen.
            </dd>
          </div>
          <div>
            <dt class="font-medium">Your statuses, not a fixed enum</dt>
            <dd class="mt-2 text-ink-soft">
              pending, error, default, empty, not-found, or
              <code class="font-mono text-ink">show-input</code>. The helper
              infers the union from <code class="font-mono text-ink">set()</code>.
            </dd>
          </div>
          <div>
            <dt class="font-medium">Payload per status</dt>
            <dd class="mt-2 text-ink-soft">
              <code class="font-mono text-ink">set("default", {"{"} book {"}"})</code>
              carries data on that branch. pending does not need a fake book.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="install" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20">
        <h2 class="text-2xl font-medium">Install</h2>
        <pre
          class="mt-6 inline-block overflow-x-auto rounded-lg border border-line bg-paper-2 px-4 py-3 font-mono text-sm"
        ><code>{install}</code></pre>
        <p class="mt-4">
          <a href={github} class="text-sm text-ink-soft hover:text-ink">GitHub</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-6 text-sm text-ink-soft"
    >
      <p>MIT · BearStudio</p>
      <p>
        <a href={github} class="hover:text-ink">GitHub</a>
        <span aria-hidden="true"> · </span>
        <a href="https://www.bearstudio.fr" class="hover:text-ink">bearstudio.fr</a>
      </p>
    </div>
  </footer>
</Layout>
